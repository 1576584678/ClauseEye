{
  "name": "clauseeye",
  "private": true,
  "version": "0.7.2",
  "type": "module",
  "description": "ClauseEye / 契眼 — 本地优先的个人合同文档管家：坑点扫描、Offer 对比、到期提醒、离线 OCR（桌面版 + Web 版）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icon": "node scripts/make-icon.mjs",
    "electron": "npm run build && electron .",
    "electron:dev": "cross-env CLAUSEEYE_DEV_URL=http://localhost:5173 electron .",
    "electron:smoke": "npm run build && cross-env CLAUSEEYE_SMOKE=1 electron .",
    "dist": "npm run build:release && node scripts/dist.mjs",
    "dist:release": "npm run build:release && node scripts/dist.mjs --publish",
    "dist:green": "npm run build:release && node scripts/build-green.mjs",
    "tessdata": "node scripts/fetch-tessdata.mjs",
    "dedupe:releases": "node scripts/dedupe-releases.mjs",
    "publish:release": "node scripts/publish-release.mjs",
    "benchmark": "vitest run src/core/tests/benchmark.test.ts --reporter=verbose",
    "build:release": "npm run tessdata && npm run build"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "main": "electron/main.cjs",
  "author": "ClauseEye",
  "license": "MIT",
  "build": {
    "appId": "com.clauseeye.app",
    "productName": "ClauseEye",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/tesseract.js-core/*.wasm.js",
      "!node_modules/tesseract.js/dist/**",
      "!node_modules/tesseract.js/docs/**"
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": ["zh-CN", "en-US"],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "ClauseEye-${version}-win-x64-portable.exe",
      "unpackDirName": "ClauseEye"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "artifactName": "ClauseEye-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Office",
      "maintainer": "ClauseEye <clauseeye@users.noreply.github.com>",
      "synopsis": "本地优先的合同文档管家：离线规则扫描 / Offer 对比 / 到期提醒",
      "artifactName": "ClauseEye-${version}-linux-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "1576584678",
        "repo": "ClauseEye",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "**/node_modules/**",
      "dist/tessdata/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClauseEye 契眼",
      "deleteAppDataOnUninstall": false,
      "artifactName": "ClauseEye-${version}-win-x64-setup.exe"
    }
  },
  "productName": "ClauseEye"
}
